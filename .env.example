# Hunonic Dashboard - Environment Configuration
# Copy this file to .env and fill in your credentials

# ==========================================
# HUNONIC CREDENTIALS (REQUIRED)
# ==========================================
HUNONIC_PHONE=+84353700780
HUNONIC_PASSWORD=La526488!

# ==========================================
# SERVER CONFIGURATION
# ==========================================
PORT=3000
NODE_ENV=production

# ==========================================
# DATABASE (Optional - for caching/history)
# ==========================================
# DATABASE_URL=postgresql://user:pass@db:5432/hunonic
# REDIS_URL=redis://redis:6379

# ==========================================
# JWT SECRET (for internal API auth)
